# Confused Deputy Lab - Environment Variables
# Copy this file to .env and fill in your actual values

# ==============================================================================
# REQUIRED: Google API Key
# ==============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
# This is required for running the Google ADK agents with Gemini models
GOOGLE_API_KEY=your-google-api-key-here

# ==============================================================================
# OPTIONAL: Arize AX Observability
# ==============================================================================
# Arize AX provides real-time tracing and monitoring for all three agents
# Sign up at: https://app.arize.com
#
# How to get these values:
# 1. Create an account at https://app.arize.com
# 2. Create a new Space
# 3. Go to Space Settings to find your Space ID
# 4. Go to Settings → API Keys to generate an API key
#
# If these are not set, agents will run normally without observability

# Space ID (base64 encoded string from Arize settings)
ARIZE_SPACE_ID=your-arize-space-id-here

# API Key (starts with "ak-" followed by UUID and token)
ARIZE_API_KEY=your-arize-api-key-here

# ==============================================================================
# OPTIONAL: Development Environment
# ==============================================================================
# Conda environment name (used for development only)
# CONDA_ENV=agent-tools-attack-vectors
